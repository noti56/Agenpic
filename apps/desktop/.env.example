# Copy this to .env.production (same directory) and fill in your backend's
# real address before running `pnpm --filter @agenpic/desktop tauri build`.
#
# These are baked into the built app at compile time — a shipped .exe never
# reads this file. To point an already-distributed build at a different
# backend, you must edit these, rebuild, and redistribute; there is no
# runtime override.
#
# Prefer a stable hostname over a raw LAN IP (mDNS ".local" name, or a
# static DHCP reservation on the host) — if the IP changes later, every
# installed copy breaks until you rebuild and redistribute.

VITE_POCKETBASE_URL=http://mini-pc.local:8090
VITE_SERVER_URL=http://mini-pc.local:4001
